#include <windows.h>

#define IDI_SMARTMENU 101

IDI_SMARTMENU ICON "smartmenu.ico"
1 RT_MANIFEST "smartmenu.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "SmartMenu QR\0"
      VALUE "FileDescription",  "SmartMenu QR - Controleur Serveur Local Wi-Fi\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "SmartMenuQR\0"
      VALUE "OriginalFilename", "SmartMenuQR.exe\0"
      VALUE "ProductName",      "SmartMenu QR\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
